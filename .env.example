NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin operations that
# must bypass Row Level Security (e.g. the admin panel reading all submissions).
SUPABASE_SECRET_KEY=
# Server-only. From console.anthropic.com (API keys page, not your Claude
# Code login). Powers the real photo-analysis pipeline in /new.
ANTHROPIC_API_KEY=
# Comma-separated allowlist of emails allowed into /admin. No spaces needed
# around commas. Whoever signs up at /signup with one of these emails gets
# admin access — everyone else is redirected away from /admin.
ADMIN_EMAILS=
