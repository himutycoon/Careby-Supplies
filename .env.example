NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used for admin operations that
# must bypass Row Level Security (e.g. the admin panel reading all submissions).
SUPABASE_SECRET_KEY=
# Server-only. From console.anthropic.com (API keys page, not your Claude
# Code login). Powers the real photo-analysis pipeline in /new.
ANTHROPIC_API_KEY=
# Comma-separated allowlist of emails allowed into /admin. No spaces needed
# around commas. Whoever signs up at /signup with one of these emails gets
# admin access — everyone else is redirected away from /admin.
ADMIN_EMAILS=

# --- Stripe -----------------------------------------------------------------
# Payments are optional: leave these unset and checkout records the order
# without charging, showing the shopper that payment is not configured.
# Test keys start sk_test_ / pk_test_; swap both to live_ together.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard webhook endpoint, or from `stripe listen` locally.
# Without it the webhook refuses every request and no order is ever marked paid.
STRIPE_WEBHOOK_SECRET=

# Absolute URL of the deployed site, used for Stripe return URLs.
# Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=
